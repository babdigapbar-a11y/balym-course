rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function validUser() {
      return request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.points is number
        && request.resource.data.points >= 0;
    }

    match /users/{uid} {
      // таблица лидеров: все вошедшие пользователи видят имя, аватар и очки
      allow read: if signedIn();
      // новый пользователь всегда начинает с 0 очков
      allow create: if isOwner(uid) && validUser() && request.resource.data.points == 0;
      // за одно сохранение нельзя прибавить больше 200 очков
      allow update: if isOwner(uid)
        && validUser()
        && request.resource.data.points - resource.data.points <= 200
        && request.resource.data.get('weeklyPoints', 0) - resource.data.get('weeklyPoints', 0) <= 200;
      allow delete: if false;

      match /progress/{courseId} {
        allow read, write: if isOwner(uid);
      }
      match /words/{wordId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
